# Template only — copy to .env and fill in real values locally.
# .env is git-ignored and must never be committed.
#
# These are optional, for local tooling that talks to your Databricks
# workspace (e.g. the Databricks CLI or Databricks Connect) or that
# needs to identify your target workspace for scripts. Spark/Delta/Unity
# Catalog execution itself always happens in Azure Databricks, not here.

# Azure Databricks workspace URL, e.g. https://adb-xxxxxxxxxxxx.xx.azuredatabricks.net
DATABRICKS_HOST=

# Personal access token or other credential for the Databricks CLI /
# Databricks Connect. Prefer a short-lived token over a long-lived PAT
# where possible. Never hardcode this in notebooks or scripts.
DATABRICKS_TOKEN=

# Do not add real catalog/schema names, cluster IDs, or personal
# workspace identifiers to this template — those stay local to your own
# .env and are never committed.
